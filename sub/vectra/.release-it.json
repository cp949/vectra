{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "cd ../.. && log=$(mktemp) && if pnpm release:check > \"$log\" 2>&1; then rm -f \"$log\"; else tail -n 100 \"$log\"; echo \"release:check 실패. 전체 로그: $log\"; exit 1; fi",
    "before:release": "git add --update ../../CHANGELOG.md"
  },
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: @cp949/vectra v${version} 배포",
    "tagName": "v${version}",
    "tagAnnotation": "@cp949/vectra v${version}",
    "push": true
  },
  "npm": {
    "publish": true,
    "publishPackageManager": "pnpm",
    "publishArgs": ["--access", "public", "--no-git-checks"]
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "../../CHANGELOG.md",
      "addUnreleased": true,
      "addVersionUrl": true
    }
  }
}
