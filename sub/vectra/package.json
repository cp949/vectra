{
  "name": "@cp949/vectra",
  "version": "1.1.0",
  "description": "TypeScript geometry/math function catalog",
  "keywords": [
    "geometry",
    "2d",
    "typescript",
    "math"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/vectra.git",
    "directory": "sub/vectra"
  },
  "homepage": "https://github.com/cp949/vectra#readme",
  "bugs": {
    "url": "https://github.com/cp949/vectra/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown && node ./scripts/generate-llm-txt.mjs",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "clean": "rimraf dist coverage llm.txt",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint:package": "npx --yes publint@0.3.25 . && npx --yes @arethetypeswrong/cli@0.18.5 --pack . --profile esm-only",
    "surface:check": "vitest run --config vitest.config.ts tests/contract/source-surface-drift.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.config.ts tests/contract",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxc-parser": "^0.154.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
