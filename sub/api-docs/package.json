{
  "name": "@repo/api-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:api": "typedoc --options ./typedoc.config.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings . && oxfmt --check .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix . && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3"
  }
}
