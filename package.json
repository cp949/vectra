{
  "name": "@jjfive/vectra-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript geometry/math function catalog",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "canvas-demo": "pnpm --filter @repo/canvas-demo dev",
    "pixi-demo": "pnpm --filter @repo/pixi-demo dev",
    "showcase": "pnpm --filter @repo/showcase dev",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "governance:report": "node scripts/report-api-governance.mjs",
    "governance:report:strict": "node scripts/report-api-governance.mjs --strict",
    "import-boundary:check": "node scripts/check-public-import-boundary.mjs",
    "import-boundary:test": "node --test scripts/check-public-import-boundary.test.mjs",
    "import-boundary:update": "node scripts/check-public-import-boundary.mjs --write",
    "jsdoc:companion:report": "node scripts/check-jsdoc-companion-responsibility.mjs",
    "jsdoc:companion:check": "node scripts/check-jsdoc-companion-responsibility.mjs --strict",
    "surface:check": "pnpm --filter @cp949/vectra surface:check",
    "examples:coverage": "node scripts/examples/coverage-report.mjs",
    "examples:typecheck": "turbo run typecheck:examples",
    "examples:coverage:strict": "node scripts/examples/coverage-report.mjs --strict",
    "examples:coverage:test": "node --test scripts/examples/coverage-report.test.mjs",
    "examples:coverage:write": "node scripts/examples/coverage-report.mjs --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "verify:vectra": "pnpm --filter @cp949/vectra typecheck && pnpm --filter @cp949/vectra lint && pnpm --filter @cp949/vectra test",
    "verify:apps-impact": "turbo run typecheck typecheck:examples test --filter=...@cp949/vectra --filter=@repo/playground --filter=!@cp949/vectra",
    "verify": "pnpm examples:coverage:test && pnpm governance:report:strict && pnpm import-boundary:test && pnpm import-boundary:check && pnpm jsdoc:companion:check && turbo run typecheck typecheck:examples lint format:check test build",
    "release:check": "pnpm verify && pnpm test:contract && pnpm --filter @cp949/vectra lint:package && cd sub/vectra && npm pack --dry-run",
    "release-it": "cd sub/vectra && release-it"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@release-it/keep-a-changelog": "8.0.1",
    "@types/node": "^26.6.5",
    "oxc-parser": "^0.154.0",
    "release-it": "21.1.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": "6.2.3",
      "dompurify": "3.4.16",
      "esbuild": "0.28.2"
    }
  }
}
